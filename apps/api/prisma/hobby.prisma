model Hobby {
  id          Int         @id @default(autoincrement())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  name        String
  color       String
  icon        String
  description String?
  status      HobbyStatus @default(DRAFT)
  selections  UserHobby[]
}

enum HobbyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
