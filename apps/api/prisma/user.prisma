model User {
  id             Int        @id @default(autoincrement())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  displayName    String?
  username       String     @unique
  email          String     @unique
  password       String
  profilePicture String?
  coverImage     String?
  bio            String?
  role           UserRole   @default(HOBBYIST)
  visibility     Visibility @default(PRIVATE)
  status         UserStatus @default(VERIFY)
  token          Token[]

  @@index([id, username])
}

enum UserRole {
  ADMIN
  HOBBYIST
}

enum Visibility {
  PRIVATE
  PUBLIC
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  VERIFY
  DELETED
}
