<html lang='en' xmlns='http://www.w3.org/1999/xhtml'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta http-equiv='X-UA-Compatible' content='IE=edge' />
    <title>Your Hobbly verification code</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Nunito:wght@400;600;800&display=swap');
      body {
        margin: 0;
        padding: 0;
        background-color: #fbf6ee;
      }
      a {
        color: inherit;
      }
      @media only screen and (max-width: 620px) {
        .email-wrapper {
          padding: 16px !important;
        }
        .email-card {
          padding: 28px 20px !important;
        }
        .code-digit {
          font-size: 36px !important;
          padding: 12px 10px !important;
          min-width: 36px !important;
        }
      }
    </style>
  </head>
  <body
    style="margin:0;padding:0;background-color:#FBF6EE;font-family:'Nunito',Arial,sans-serif;"
  >

    <table
      width='100%'
      cellpadding='0'
      cellspacing='0'
      border='0'
      style='background-color:#FBF6EE;'
    >
      <tr>
        <td align='center' class='email-wrapper' style='padding:40px 16px;'>
          <table
            width='100%'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='max-width:560px;'
          >

            <!-- ── HEADER ── -->
            <tr>
              <td
                style='background-color:#1C2B3A;border-radius:20px 20px 0 0;padding:28px 36px 24px;text-align:center;'
              >
                <p
                  style="margin:0 0 4px;font-family:'Playfair Display',Georgia,serif;font-size:28px;font-weight:600;color:#FBF6EE;letter-spacing:-0.3px;"
                >
                  ✨ Hobbly
                </p>
                <p
                  style="margin:0;font-family:'Nunito',Arial,sans-serif;font-size:13px;color:#A8BCCF;letter-spacing:0.2px;"
                >
                  A cozy place for everything you love
                </p>
              </td>
            </tr>

            <!-- ── LAVENDER ACCENT STRIPE ── -->
            <tr>
              <td
                style='background-color:#C8A2E3;height:4px;font-size:0;line-height:0;'
              >&nbsp;</td>
            </tr>

            <!-- ── BODY ── -->
            <tr>
              <td
                class='email-card'
                style='background-color:#FFFFFF;padding:40px 40px 36px;border-left:1px solid #EDE8DF;border-right:1px solid #EDE8DF;'
              >

                <p
                  style='margin:0 0 20px;text-align:center;font-size:48px;line-height:1;'
                >💫</p>

                <h1
                  style="margin:0 0 10px;font-family:'Playfair Display',Georgia,serif;font-size:26px;font-weight:600;color:#1C2B3A;text-align:center;line-height:1.25;"
                >
                  Your verification code
                </h1>

                <p
                  style="margin:0 0 6px;font-family:'Nunito',Arial,sans-serif;font-size:15px;color:#4A5568;text-align:center;line-height:1.6;"
                >
                  Hi
                  {{name}},
                </p>
                <p
                  style="margin:0 0 36px;font-family:'Nunito',Arial,sans-serif;font-size:15px;color:#4A5568;text-align:center;line-height:1.6;"
                >
                  Use the code below to
                  {{purpose}}. This code is single-use and will expire shortly.
                </p>

                <!-- ── 6-DIGIT CODE BLOCK ── -->
                <table
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='margin-bottom:32px;'
                >
                  <tr>
                    <td align='center'>

                      <!-- Outer code container -->
                      <table
                        cellpadding='0'
                        cellspacing='0'
                        border='0'
                        style='background-color:#FBF6EE;border-radius:18px;border:2px solid #C8A2E340;padding:4px;'
                      >
                        <tr>
                          <!-- Digit 1 -->
                          <td
                            class='code-digit'
                            align='center'
                            style="font-family:'Courier New',Courier,monospace;font-size:42px;font-weight:800;color:#1C2B3A;padding:16px 12px;min-width:44px;letter-spacing:0;background-color:#FFFFFF;border-radius:12px;margin:0 2px;border:1.5px solid #EDE8DF;"
                          >
                            {{digit1}}
                          </td>
                          <td style='width:6px;font-size:0;'>&nbsp;</td>
                          <!-- Digit 2 -->
                          <td
                            class='code-digit'
                            align='center'
                            style="font-family:'Courier New',Courier,monospace;font-size:42px;font-weight:800;color:#1C2B3A;padding:16px 12px;min-width:44px;background-color:#FFFFFF;border-radius:12px;border:1.5px solid #EDE8DF;"
                          >
                            {{digit2}}
                          </td>
                          <td style='width:6px;font-size:0;'>&nbsp;</td>
                          <!-- Digit 3 -->
                          <td
                            class='code-digit'
                            align='center'
                            style="font-family:'Courier New',Courier,monospace;font-size:42px;font-weight:800;color:#1C2B3A;padding:16px 12px;min-width:44px;background-color:#FFFFFF;border-radius:12px;border:1.5px solid #EDE8DF;"
                          >
                            {{digit3}}
                          </td>
                          <!-- Spacer between groups -->
                          <td style='width:14px;font-size:0;'>&nbsp;</td>
                          <!-- Digit 4 -->
                          <td
                            class='code-digit'
                            align='center'
                            style="font-family:'Courier New',Courier,monospace;font-size:42px;font-weight:800;color:#9B72CB;padding:16px 12px;min-width:44px;background-color:#F9F5FF;border-radius:12px;border:1.5px solid #C8A2E340;"
                          >
                            {{digit4}}
                          </td>
                          <td style='width:6px;font-size:0;'>&nbsp;</td>
                          <!-- Digit 5 -->
                          <td
                            class='code-digit'
                            align='center'
                            style="font-family:'Courier New',Courier,monospace;font-size:42px;font-weight:800;color:#9B72CB;padding:16px 12px;min-width:44px;background-color:#F9F5FF;border-radius:12px;border:1.5px solid #C8A2E340;"
                          >
                            {{digit5}}
                          </td>
                          <td style='width:6px;font-size:0;'>&nbsp;</td>
                          <!-- Digit 6 -->
                          <td
                            class='code-digit'
                            align='center'
                            style="font-family:'Courier New',Courier,monospace;font-size:42px;font-weight:800;color:#9B72CB;padding:16px 12px;min-width:44px;background-color:#F9F5FF;border-radius:12px;border:1.5px solid #C8A2E340;"
                          >
                            {{digit6}}
                          </td>
                        </tr>
                      </table>

                      <!-- Fallback: full code as text below the boxes -->
                      <p
                        style="margin:12px 0 0;font-family:'Nunito',Arial,sans-serif;font-size:12px;color:#B0BEC5;text-align:center;letter-spacing:0.5px;"
                      >
                        Full code:
                        <strong
                          style='color:#6B7A8B;letter-spacing:3px;'
                        >{{code}}</strong>
                      </p>

                    </td>
                  </tr>
                </table>

                <!-- Expiry note -->
                <table
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='margin-bottom:28px;'
                >
                  <tr>
                    <td
                      align='center'
                      style='padding:12px 20px;background-color:#FBF6EE;border-radius:12px;border:1px solid #EDE8DF;'
                    >
                      <p
                        style="margin:0;font-family:'Nunito',Arial,sans-serif;font-size:13px;color:#6B7A8B;line-height:1.5;"
                      >
                        ⏱ This code expires in
                        <strong style='color:#1C2B3A;'>{{expiryMinutes}}
                          minutes</strong>
                        and can only be used once.
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- Divider -->
                <table
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='margin-bottom:20px;'
                >
                  <tr>
                    <td
                      style='border-top:1px solid #EDE8DF;font-size:0;line-height:0;'
                    >&nbsp;</td>
                  </tr>
                </table>

                <!-- Security note -->
                <p
                  style="margin:0;font-family:'Nunito',Arial,sans-serif;font-size:13px;color:#8A9AAA;text-align:center;line-height:1.6;"
                >
                  🔒 Never share this code with anyone.<br />
                  Hobbly will never ask for your code via phone, chat, or email.
                </p>

              </td>
            </tr>

            <!-- ── FOOTER ── -->
            <tr>
              <td
                style='background-color:#F0EBE1;border-radius:0 0 20px 20px;padding:24px 36px;text-align:center;border-left:1px solid #EDE8DF;border-right:1px solid #EDE8DF;border-bottom:1px solid #EDE8DF;'
              >
                <p
                  style="margin:0 0 8px;font-family:'Nunito',Arial,sans-serif;font-size:12px;color:#8A9AAA;line-height:1.6;"
                >
                  This code was requested for your Hobbly account.<br />
                  If you didn't request this, please ignore it — your account is
                  safe.
                </p>
                <p
                  style="margin:0;font-family:'Nunito',Arial,sans-serif;font-size:12px;color:#B0BEC5;"
                >
                  ©
                  {{year}}
                  Hobbly · Made with ✨ for hobby lovers
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>

  </body>
</html>