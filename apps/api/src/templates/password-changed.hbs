<html lang='en' xmlns='http://www.w3.org/1999/xhtml'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta http-equiv='X-UA-Compatible' content='IE=edge' />
    <title>Your Hobbly password was changed</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Nunito:wght@400;600&display=swap');
      body {
        margin: 0;
        padding: 0;
        background-color: #fbf6ee;
      }
      a {
        color: inherit;
      }
      @media only screen and (max-width: 620px) {
        .email-wrapper {
          padding: 16px !important;
        }
        .email-card {
          padding: 28px 20px !important;
        }
      }
    </style>
  </head>
  <body
    style="margin:0;padding:0;background-color:#FBF6EE;font-family:'Nunito',Arial,sans-serif;"
  >

    <table
      width='100%'
      cellpadding='0'
      cellspacing='0'
      border='0'
      style='background-color:#FBF6EE;'
    >
      <tr>
        <td align='center' class='email-wrapper' style='padding:40px 16px;'>
          <table
            width='100%'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='max-width:560px;'
          >

            <!-- ── HEADER ── -->
            <tr>
              <td
                style='background-color:#1C2B3A;border-radius:20px 20px 0 0;padding:28px 36px 24px;text-align:center;'
              >
                <p
                  style="margin:0 0 4px;font-family:'Playfair Display',Georgia,serif;font-size:28px;font-weight:600;color:#FBF6EE;letter-spacing:-0.3px;"
                >
                  ✨ Hobbly
                </p>
                <p
                  style="margin:0;font-family:'Nunito',Arial,sans-serif;font-size:13px;color:#A8BCCF;letter-spacing:0.2px;"
                >
                  A cozy place for everything you love
                </p>
              </td>
            </tr>

            <!-- ── GREEN ACCENT STRIPE ── -->
            <tr>
              <td
                style='background-color:#8BAF8B;height:4px;font-size:0;line-height:0;'
              >&nbsp;</td>
            </tr>

            <!-- ── BODY ── -->
            <tr>
              <td
                class='email-card'
                style='background-color:#FFFFFF;padding:40px 40px 32px;border-left:1px solid #EDE8DF;border-right:1px solid #EDE8DF;'
              >

                <p
                  style='margin:0 0 20px;text-align:center;font-size:48px;line-height:1;'
                >🔒</p>

                <h1
                  style="margin:0 0 12px;font-family:'Playfair Display',Georgia,serif;font-size:26px;font-weight:600;color:#1C2B3A;text-align:center;line-height:1.25;"
                >
                  Password successfully changed
                </h1>

                <p
                  style="margin:0 0 32px;font-family:'Nunito',Arial,sans-serif;font-size:15px;color:#4A5568;text-align:center;line-height:1.6;"
                >
                  Hi
                  {{username}}, this is a confirmation that the password for
                  your Hobbly account was just updated.
                </p>

                <!-- Change details box -->
                <table
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='margin-bottom:28px;'
                >
                  <tr>
                    <td
                      style='padding:20px 24px;background-color:#F5FFF5;border-radius:14px;border:1px solid #8BAF8B40;'
                    >

                      <!-- Row: Account -->
                      <table
                        width='100%'
                        cellpadding='0'
                        cellspacing='0'
                        border='0'
                        style='margin-bottom:12px;'
                      >
                        <tr>
                          <td
                            style="width:50%;font-family:'Nunito',Arial,sans-serif;font-size:13px;color:#8A9AAA;vertical-align:top;"
                          >Account</td>
                          <td
                            style="width:50%;font-family:'Nunito',Arial,sans-serif;font-size:13px;color:#1C2B3A;font-weight:600;text-align:right;vertical-align:top;"
                          >{{email}}</td>
                        </tr>
                      </table>

                      <!-- Divider -->
                      <table
                        width='100%'
                        cellpadding='0'
                        cellspacing='0'
                        border='0'
                        style='margin-bottom:12px;'
                      >
                        <tr><td
                            style='border-top:1px solid #8BAF8B30;font-size:0;line-height:0;'
                          >&nbsp;</td></tr>
                      </table>

                      <!-- Row: Changed at -->
                      <table
                        width='100%'
                        cellpadding='0'
                        cellspacing='0'
                        border='0'
                      >
                        <tr>
                          <td
                            style="width:50%;font-family:'Nunito',Arial,sans-serif;font-size:13px;color:#8A9AAA;vertical-align:top;"
                          >Changed at</td>
                          <td
                            style="width:50%;font-family:'Nunito',Arial,sans-serif;font-size:13px;color:#1C2B3A;font-weight:600;text-align:right;vertical-align:top;"
                          >{{changedAt}}</td>
                        </tr>
                      </table>

                    </td>
                  </tr>
                </table>

                <!-- Alert box: wasn't you? -->
                <table
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='margin-bottom:28px;'
                >
                  <tr>
                    <td
                      style='padding:14px 18px;background-color:#FFF4F3;border-radius:12px;border:1px solid #E8857A50;border-left:4px solid #E8857A;'
                    >
                      <p
                        style="margin:0 0 8px;font-family:'Nunito',Arial,sans-serif;font-size:13px;color:#9B3B30;font-weight:600;"
                      >
                        ⚠️ Didn't make this change?
                      </p>
                      <p
                        style="margin:0;font-family:'Nunito',Arial,sans-serif;font-size:13px;color:#9B3B30;line-height:1.6;"
                      >
                        If you didn't change your password, your account may be
                        compromised. Please contact our support team immediately
                        so we can help you secure your account.
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- CTA Button: Contact support -->
                <table
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='margin-bottom:20px;'
                >
                  <tr>
                    <td align='center'>
                      <table cellpadding='0' cellspacing='0' border='0'>
                        <tr>
                          <td
                            style='background-color:#E8857A;border-radius:50px;box-shadow:0 4px 14px rgba(232,133,122,0.3);'
                          >
                            <a
                              href='mailto:geraldtolentino015@gmail.com'
                              style="display:inline-block;padding:13px 30px;font-family:'Nunito',Arial,sans-serif;font-size:14px;font-weight:600;color:#FFFFFF;text-decoration:none;letter-spacing:0.2px;"
                            >
                              Contact Support
                            </a>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <!-- Divider -->
                <table
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='margin-bottom:20px;'
                >
                  <tr>
                    <td
                      style='border-top:1px solid #EDE8DF;font-size:0;line-height:0;'
                    >&nbsp;</td>
                  </tr>
                </table>

                <p
                  style="margin:0;font-family:'Nunito',Arial,sans-serif;font-size:13px;color:#8A9AAA;text-align:center;line-height:1.6;"
                >
                  If this was you — great, you're all set! 🌿<br />
                  Your hobbies are waiting for you.
                </p>

              </td>
            </tr>

            <!-- ── FOOTER ── -->
            <tr>
              <td
                style='background-color:#F0EBE1;border-radius:0 0 20px 20px;padding:24px 36px;text-align:center;border-left:1px solid #EDE8DF;border-right:1px solid #EDE8DF;border-bottom:1px solid #EDE8DF;'
              >
                <p
                  style="margin:0 0 8px;font-family:'Nunito',Arial,sans-serif;font-size:12px;color:#8A9AAA;line-height:1.6;"
                >
                  This is an automated security notification for your Hobbly
                  account.<br />
                  Need help?
                  <a
                    href='mailto:support@hobbly.app'
                    style='color:#5BB3D0;text-decoration:none;'
                  >support@hobbly.app</a>
                </p>
                <p
                  style="margin:0;font-family:'Nunito',Arial,sans-serif;font-size:12px;color:#B0BEC5;"
                >
                  ©
                  {{year}}
                  Hobbly · Made with ✨ for hobby lovers
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>

  </body>
</html>